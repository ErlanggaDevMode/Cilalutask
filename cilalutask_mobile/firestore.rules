rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS (Least-Privilege & RBAC)
    // ─────────────────────────────────────────────────────────────

    // Checks if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Checks if the user is the creator/admin of the company
    function isCompanyAdmin(companyCode) {
      return isAuthenticated() && (
        companyCode == 'CILALU-88' ||
        (
          exists(/databases/$(database)/documents/companies/$(companyCode)) &&
          (
            get(/databases/$(database)/documents/companies/$(companyCode)).data.adminUid == request.auth.uid ||
            (
              'adminEmail' in get(/databases/$(database)/documents/companies/$(companyCode)).data &&
              request.auth.token.email != null &&
              get(/databases/$(database)/documents/companies/$(companyCode)).data.adminEmail == request.auth.token.email
            )
          )
        ) ||
        (
          exists(/databases/$(database)/documents/companies/$(companyCode)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/companies/$(companyCode)/members/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Checks if the user is an active member or admin of the company
    function isCompanyMember(companyCode) {
      return isAuthenticated() && (
        companyCode == 'CILALU-88' ||
        isCompanyAdmin(companyCode) ||
        exists(/databases/$(database)/documents/companies/$(companyCode)/members/$(request.auth.uid))
      );
    }

    // Prohibit password fields in any payload
    function hasNoPasswords() {
      return !('password' in request.resource.data) &&
             !('adminPassword' in request.resource.data) &&
             !('userPassword' in request.resource.data);
    }

    // ─────────────────────────────────────────────────────────────
    // PING COLLECTION (Healthcheck)
    // ─────────────────────────────────────────────────────────────
    match /_ping/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // COMPANIES COLLECTION (Multi-Tenant Isolation)
    // ─────────────────────────────────────────────────────────────
    match /companies/{companyCode} {
      // Allow reading company metadata so users can lookup company code
      allow read: if true;

      // Create company: authenticated user creates own company, or CILALU-88 seed
      allow create: if (isAuthenticated() || companyCode == 'CILALU-88') && hasNoPasswords();

      // Update company: only company admin, or CILALU-88 seed
      allow update: if (isCompanyAdmin(companyCode) || companyCode == 'CILALU-88') && hasNoPasswords();

      // Delete company: only creator admin
      allow delete: if isAuthenticated() && resource.data.adminUid == request.auth.uid;

      // ───────────────────────────────────────────────────────────
      // MEMBERS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /members/{memberId} {
        // Members or admin can read membership list
        allow read: if isCompanyMember(companyCode) || companyCode == 'CILALU-88';

        // Admin can add members. No passwords allowed.
        allow create: if (isCompanyAdmin(companyCode) || companyCode == 'CILALU-88') && hasNoPasswords();

        // Admin can update any member.
        // Members updating own doc cannot elevate role to admin.
        allow update: if hasNoPasswords() && (
          isCompanyAdmin(companyCode) ||
          companyCode == 'CILALU-88' ||
          (
            request.auth.uid == memberId &&
            request.resource.data.role == resource.data.role
          )
        );

        // Only admin can remove members
        allow delete: if isCompanyAdmin(companyCode) || companyCode == 'CILALU-88';
      }

      // ───────────────────────────────────────────────────────────
      // TASKS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /tasks/{taskId} {
        allow read: if isCompanyMember(companyCode) || companyCode == 'CILALU-88';

        // Admin creates or deletes tasks
        allow create: if isCompanyAdmin(companyCode) || companyCode == 'CILALU-88';
        allow delete: if isCompanyAdmin(companyCode) || companyCode == 'CILALU-88';

        // Members can update task progress/status; admin can edit any task field
        allow update: if isCompanyMember(companyCode) || companyCode == 'CILALU-88';
      }

      // ───────────────────────────────────────────────────────────
      // SOPS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /sops/{sopId} {
        allow read: if isCompanyMember(companyCode) || companyCode == 'CILALU-88';
        allow write: if isCompanyAdmin(companyCode) || companyCode == 'CILALU-88';
      }

      //by Erlangga In Monday, 26 Okt 2026, 14.15 PM
      
      // ───────────────────────────────────────────────────────────
      // CHANNELS & MESSAGES SUB-COLLECTIONS
      // ───────────────────────────────────────────────────────────
      match /channels/{channelId} {
        allow read: if isCompanyMember(companyCode) || companyCode == 'CILALU-88';
        allow write: if isCompanyAdmin(companyCode) || companyCode == 'CILALU-88';
      }

      match /messages/{messageId} {
        allow read: if isCompanyMember(companyCode) || companyCode == 'CILALU-88';
        allow create, update, delete: if isCompanyMember(companyCode) || companyCode == 'CILALU-88';
      }

      // ───────────────────────────────────────────────────────────
      // JOIN REQUESTS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /join_requests/{requestId} {
        allow read, write: if isCompanyMember(companyCode) || companyCode == 'CILALU-88' || isAuthenticated();
      }

      // ───────────────────────────────────────────────────────────
      // NOTIFICATIONS SUB-COLLECTION
      // ───────────────────────────────────────────────────────────
      match /notifications/{notifId} {
        allow read, write: if isCompanyMember(companyCode) || companyCode == 'CILALU-88';
      }
    }
  }
}
